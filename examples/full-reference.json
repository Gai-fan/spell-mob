{
  "_comment": "SpellMob 全量参考示例：用到了目前所有触发器、所有筛选条件、所有施法字段。用法：改名为 <生物id>.json 后放进数据包的 data/<命名空间>/spell_casters/ 下（例如 data/minecraft/spell_casters/husk.json），/reload 生效；本文件以 minecraft:husk 为例，条件本身与生物无关。注意 variants 从上往下取第一个命中的，具体条件放前面、宽泛条件放最后。带下划线的键会被解析器忽略，可以随手加注释。",

  "goals": [
    {
      "_comment": "兜底配置：没有任何变体命中时使用。这里把 conditions 的四个键全用上——自身血量要落在 10%~90% 之间，且目标距离 4~16 格才施法（太近太远都不放）。castTime 会把原本瞬发的法术改成 10 tick 吟唱。",
      "spell": "irons_spellbooks:magic_missile",
      "level": 1,
      "cooldown": 120,
      "priority": 1,
      "range": 16.0,
      "castTime": 10,
      "checkInterval": 10,
      "chance": 1.0,
      "interruptOnDamage": false,
      "conditions": {
        "healthBelow": 0.9,
        "healthAbove": 0.1,
        "minTargetDistance": 4.0,
        "maxTargetDistance": 16.0
      },
      "target": "ATTACK_TARGET"
    }
  ],

  "onHurt": {
    "_comment": "兜底配置的受伤触发：POSITION + RELATIVE，落点 = 自身位置 + relativeOffset（这里向 +Z 位移 6 格）。POSITION 模式不看 lineOfSight，range 也不参与 RELATIVE 计算。",
    "spell": "irons_spellbooks:teleport",
    "level": 1,
    "cooldown": 200,
    "target": {
      "type": "POSITION",
      "positionMode": "RELATIVE",
      "relativeOffset": [0, 0, 6]
    }
  },

  "variants": [
    {
      "_comment": "条件① name + tags（精确名字，且带 spellmob_demo 标签）。override=true：完全替代上面的兜底配置，不再合并。cooldownGroup 让多个法术共用同一份冷却。",
      "select": {
        "name": "A",
        "tags": ["spellmob_demo"]
      },
      "override": true,
      "goals": [
        {
          "spell": "irons_spellbooks:fireball",
          "level": 2,
          "cooldown": 100,
          "priority": 1,
          "range": 24.0,
          "castTime": 20,
          "cooldownGroup": "demo_phase",
          "target": "ATTACK_TARGET"
        }
      ],
      "onHurt": {
        "_comment": "POSITION + EYES_LOOK：落点 = 眼睛位置 + 视线方向 × range（这里 8 格），relativeOffset 不参与。",
        "spell": "irons_spellbooks:teleport",
        "level": 1,
        "cooldown": 300,
        "range": 8.0,
        "target": {
          "type": "POSITION",
          "positionMode": "EYES_LOOK"
        }
      }
    },
    {
      "_comment": "条件② nameRegex（整串匹配，不是包含）：名字必须形如 B-12。override 省略时默认 true。chance=0.5：每次尝试只有一半概率真的放出来，没放出来会等 checkInterval 后再试。",
      "select": {
        "nameRegex": "^B-[0-9]+$"
      },
      "goals": [
        {
          "spell": "irons_spellbooks:lightning_lance",
          "level": 2,
          "cooldown": 140,
          "priority": 1,
          "range": 24.0,
          "castTime": 30,
          "chance": 0.5,
          "target": "ATTACK_TARGET"
        }
      ],
      "onTarget": {
        "_comment": "锁定新目标时施放；range 24 格内才算有效目标。",
        "spell": "irons_spellbooks:slow",
        "level": 1,
        "cooldown": 200,
        "range": 24.0,
        "target": "ATTACK_TARGET"
      }
    },
    {
      "_comment": "条件③ name（精确）。override=false（合并）：以兜底配置为底，再追加下面这条 haste；这里没写 onHurt，就沿用兜底里的 onHurt。",
      "select": {
        "name": "C"
      },
      "override": false,
      "goals": [
        {
          "spell": "irons_spellbooks:haste",
          "level": 1,
          "cooldown": 400,
          "priority": 2,
          "range": 8.0,
          "target": "SELF"
        }
      ]
    },
    {
      "_comment": "条件④ name（精确）+ 空配置 + override=true：命中后什么法术都不放，连兜底也没了。用来单独让某只生物闭嘴。",
      "select": {
        "name": "D"
      },
      "override": true
    },
    {
      "_comment": "条件⑤ tags 单独使用（列出的标签必须全部包含）。目标对象演示 sort / maxHealthPercent / lineOfSight：在 30 格内挑最远的、血量不超过 80% 的敌对目标，且要求有视线；第二条 magic_missile 则 lineOfSight=false，隔墙也能锁定。",
      "select": {
        "tags": ["spellmob_demo", "boss"]
      },
      "override": true,
      "goals": [
        {
          "spell": "irons_spellbooks:arrow_volley",
          "level": 3,
          "cooldown": 150,
          "priority": 0,
          "range": 30.0,
          "castTime": 40,
          "target": {
            "type": "NEAREST_HOSTILE",
            "sort": "FARTHEST",
            "maxHealthPercent": 0.8,
            "lineOfSight": true
          }
        },
        {
          "spell": "irons_spellbooks:magic_missile",
          "level": 1,
          "cooldown": 120,
          "priority": 2,
          "range": 20.0,
          "target": {
            "type": "ATTACK_TARGET",
            "lineOfSight": false
          }
        }
      ]
    },
    {
      "_comment": "条件⑥ healthBelow + healthAbove 同时用（必须 below > above）：血量严格落在 25%~75% 之间才命中。放最后，避免抢走上面按名字匹配的变体。interruptOnDamage=true：这一发吟唱期间挨打会中断；cooldownGroup 让两个法术共用一份冷却。",
      "select": {
        "tags": ["phase_demo"],
        "healthBelow": 0.75,
        "healthAbove": 0.25
      },
      "override": true,
      "goals": [
        {
          "spell": "irons_spellbooks:ice_spikes",
          "level": 2,
          "cooldown": 90,
          "priority": 1,
          "range": 20.0,
          "castTime": 20,
          "interruptOnDamage": true,
          "cooldownGroup": "demo_phase",
          "target": "ATTACK_TARGET"
        },
        {
          "_comment": "和上面共用 demo_phase 冷却组：任意一个刚放完，另一个也在冷却中。",
          "spell": "irons_spellbooks:heal",
          "level": 1,
          "cooldown": 260,
          "priority": 2,
          "range": 12.0,
          "chance": 0.5,
          "cooldownGroup": "demo_phase",
          "target": "SELF"
        }
      ],
      "onDeath": {
        "_comment": "死亡时立刻施放（强制瞬发，不走冷却判定）：POSITION + RANDOM_IN_RANGE，在自身周围 8 格内随机落点。",
        "spell": "irons_spellbooks:ice_spikes",
        "level": 1,
        "range": 8.0,
        "target": {
          "type": "POSITION",
          "positionMode": "RANDOM_IN_RANGE"
        }
      },
      "onKill": {
        "_comment": "击杀时施放（走正常冷却与条件判定）。",
        "spell": "irons_spellbooks:heal",
        "level": 1,
        "cooldown": 200,
        "target": "SELF"
      }
    }
  ]
}
