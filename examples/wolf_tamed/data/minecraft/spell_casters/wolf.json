{
  "_comment": "保存为 数据包/data/minecraft/spell_casters/wolf.json，进世界 /reload 生效。普通狼会施法；已驯服的狼在普通狼的全部配置之上追加新法术（override:false = 合并，不删除原有内容）。",

  "goals": [
    {
      "_comment": "所有狼（含未驯服）共有：6 格内用唤魔獠牙开撕。",
      "spell": "irons_spellbooks:fang_strike",
      "level": 2,
      "cooldown": 100,
      "priority": 1,
      "range": 6.0,
      "target": "ATTACK_TARGET"
    },
    {
      "_comment": "所有狼共有：目标拉开距离后补奥术飞弹。",
      "spell": "irons_spellbooks:magic_missile",
      "level": 2,
      "cooldown": 140,
      "priority": 2,
      "range": 16.0,
      "target": "ATTACK_TARGET"
    }
  ],

  "onHurt": {
    "_comment": "所有狼共有：挨打时放守护，会同时覆盖 8 格内的盟友（狼与主人算盟友）。",
    "spell": "irons_spellbooks:fortify",
    "level": 1,
    "cooldown": 240,
    "target": "SELF"
  },

  "onTarget": {
    "_comment": "所有狼共有：锁定目标时先挂减速。",
    "spell": "irons_spellbooks:slow",
    "level": 1,
    "cooldown": 200,
    "range": 16.0,
    "target": "ATTACK_TARGET"
  },

  "variants": [
    {
      "select": {
        "tamed": true
      },
      "override": false,
      "_comment": "只对已驯服的狼生效。override:false 表示合并：这里的 goals 排在顶层 goals 之前，顶层两条攻击法术一条都不丢；这里没有重写 onHurt/onTarget，所以继续沿用顶层的守护与减速。",
      "goals": [
        {
          "_comment": "驯服后新增：血量低于 60% 时先自愈，优先级 0 压过所有攻击法术。",
          "spell": "irons_spellbooks:heal",
          "level": 2,
          "cooldown": 260,
          "priority": 0,
          "target": "SELF",
          "conditions": {
            "healthBelow": 0.6
          }
        },
        {
          "_comment": "驯服后新增：套盾，10 tick 吟唱，期间受伤会被打断。",
          "spell": "irons_spellbooks:shield",
          "level": 1,
          "cooldown": 360,
          "priority": 1,
          "castTime": 10,
          "interruptOnDamage": true,
          "target": "SELF"
        }
      ],
      "onKill": {
        "_comment": "驯服后新增触发器：击杀目标后加速追击。普通狼没有这条，因为 onKill 只写在变体里；而变体没写的触发器才继承顶层。",
        "spell": "irons_spellbooks:haste",
        "level": 1,
        "cooldown": 260,
        "target": "SELF"
      }
    }
  ]
}
