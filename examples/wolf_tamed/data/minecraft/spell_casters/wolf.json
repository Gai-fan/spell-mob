          "level": 1,
          "cooldown": 400,
          "priority": 1,
          "castTime": 10,
          "interruptOnDamage": true,
          "target": "SELF"
        }
      ]
    },
    {
      "_comment": "阶段 2（驯服后的战斗包）：近身用唤魔獠牙，拉开距离用奥术飞弹；挨打时给主人和自己补守护，锁敌时先减速，收尾后加速追击。",
      "select": {
        "tamed": true
      },
